<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>{{namespace}}</PackageId>
    <PackageVersion>0.1.0</PackageVersion>
    <Authors>SDK-Fabric</Authors>
    <Company>{{company}}</Company>
    <Description>{{description}}</Description>
    <Copyright>{{copyright}}</Copyright>
    <RepositoryUrl>{{github_url}}</RepositoryUrl>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>{{github_user}}-{{github_repository}}</AssemblyName>
    <PackageProjectUrl>{{website}}</PackageProjectUrl>
    <PackageLicenseUrl>{{github_url}}/blob/main/LICENSE</PackageLicenseUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Sdkgen.Client" Version="2.0.3" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
      <Link>logo.png</Link>
    </None>
    <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>
</Project>
